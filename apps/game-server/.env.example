PORT=3001
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# REQUIRED (round 13): comma-separated web origins; the realm will not start without it
ALLOWED_ORIGIN=http://localhost:3002
# Backend always requires a real Supabase Auth JWT.

# Closed beta
MAX_PLAYERS=500
CLOSED_BETA=true
ENCHANTER_BUFF_RANGE=10
ENCHANTER_BUFF_MINUTES=30

# Round 13 · world boss fights back (all optional — defaults shown)
# BOSS_SWING_MS=2200
# BOSS_ENRAGED_SWING_MS=1600
# BOSS_REACH=9
# BOSS_HP_SHARE=0.05            # part of the target's max HP added to every boss hit
# BOSS_EXPECTED_DPS_SHARE=0.5   # boss HP = challengers' real DPS × this × 22 minutes
# Round 13 · how fast a reported HP / MP may rise (share of max per second)
# HP_HEAL_PCT_PER_SEC=0.08
# MP_REGEN_PCT_PER_SEC=0.25
# Map channels (round 16): channels per map and players per channel
REALM_CHANNELS=5
REALM_CHANNEL_CAP=100
