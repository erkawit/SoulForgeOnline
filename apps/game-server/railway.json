{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "apps/game-server/Dockerfile", "watchPatterns": ["apps/game-server/**", "src/game/**", "src/lib/**", "src/store/authority.ts"] },
  "deploy": { "healthcheckPath": "/health", "healthcheckTimeout": 60, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5, "numReplicas": 1 }
}
