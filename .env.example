# Demo works with these unset. To enable cloud save, fill both:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEVER put a service_role/secret key in NEXT_PUBLIC_ variables.

# Phase 2 Multiplayer browser (never secret):
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:3001
# Vault API secret - Vercel SERVER ONLY:
SUPABASE_SECRET_KEY=

# Closed beta (invite codes). true = players must sign in with an account that redeemed an invite code.
NEXT_PUBLIC_CLOSED_BETA=false
# SUPABASE_SECRET_KEY above is also required by /api/auth/register (creates the account after checking the invite).

# ---------------------------------------------------------------- Railway (see docs/RAILWAY_DEPLOY_TH.md)
# Service "web" (Root Directory = /). NEXT_PUBLIC_* are baked in at BUILD time — set them before the first deploy.
#   NEXT_PUBLIC_GAME_SERVER_URL=wss://realm.<your-domain>   (or wss://<realm>.up.railway.app)
#   PORT is injected by Railway — do not set it yourself.
# Service "realm" (Root Directory = apps/game-server):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY (above) is also required by the realm.
# Comma-separated list of web origins allowed to open a WebSocket. REQUIRED since round 13: the realm refuses to start
# without it (set ALLOW_ANY_ORIGIN=1 only for a local LAN test).
ALLOWED_ORIGIN=http://localhost:3002
MAX_PLAYERS=200
PARTY_GRACE_SECONDS=120
CLOSED_BETA=false
# Map channels (round 16): channels per map and players per channel
REALM_CHANNELS=5
REALM_CHANNEL_CAP=100

# ---------------------------------------------------------------- Netlify + Supabase (round 12, docs/NETLIFY_SUPABASE_TH.md)
# Netlify site env (Site settings → Environment variables). NEXT_PUBLIC_* are build-time: redeploy after changing them.
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY (server only, never NEXT_PUBLIC_)
#   NEXT_PUBLIC_GAME_SERVER_URL=wss://<realm host>   NEXT_PUBLIC_CLOSED_BETA=true
# Cash shop (only after a merchant account exists — until then orders stay pending and nothing is granted):
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
